# Copy to .env for local dev. On Netlify, set these in Site config → Environment variables.

# ── Supabase auth (required) ──────────────────────────────────────────────
# Project URL and anon/public key from Supabase → Project Settings → API.
# Used by src/lib/supabaseClient.js for email/password login and JWT-authed
# admin saves.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend API (recommended) ─────────────────────────────────────────────
# Base URL of the Express backend (Render), e.g. https://internalcalc.onrender.com
# When set, the admin pipeline reads/writes parameters through the
# Supabase-backed backend — the same store the quote engine reads, so admin
# edits reflect in quotes. Leave blank for local dev to use the legacy Netlify
# Blobs function instead.
VITE_API_BASE_URL=

# ── Maintenance gate (optional) ───────────────────────────────────────────
# Standalone password for the pre-launch maintenance gate. Unrelated to
# Supabase roles — leave blank to disable the gate.
VITE_MAINTENANCE_PASSWORD=
